{
  "$schema": "https://opencode.ai/config.json",
  "share": "disabled",
  "permission": {
    "read": { "*": "allow", "*.env": "deny", "*.env.*": "deny", "*.env.example": "allow", "**/.data/**": "deny" },
    "edit": { "*": "allow", "*.env": "deny", "*.env.*": "deny", "**/.data/**": "deny", "evidence/**": "ask" },
    "bash": {
      "*": "ask",
      "python -B -m unittest*": "allow",
      "node tests/*": "allow",
      "git status*": "allow",
      "git diff*": "allow",
      "*.env*": "deny",
      "env": "deny",
      "printenv*": "deny",
      "set": "deny"
    },
    "external_directory": "deny",
    "webfetch": "ask",
    "websearch": "ask"
  }
}
