# Personal-account configuration only. Never use the classroom tutorial account.
# Copy to .env locally; keep .env, API keys and .data/ out of Git and submission ZIPs.
# The application never writes to SAP and never performs approval or payment.
AIRASSIST_SAP_MODE=unconfigured
AIRASSIST_SAP_ACCOUNT_TYPE=personal

# Verified SAP Business Accelerator Hub Credit Memo Request V4 sandbox service.
# Only HTTPS URLs at api.sap.com or sandbox.api.sap.com are accepted.
# Supply the service root ending /0001, without an entity name or query string.
AIRASSIST_SAP_BASE_URL=https://sandbox.api.sap.com/s4hanacloud/sap/opu/odata4/sap/api_creditmemorequest/srvd_a2x/sap/creditmemorequest/0001
AIRASSIST_SAP_API_KEY=

AIRASSIST_PORT=8789
AIRASSIST_DATABASE=.data/airassist.sqlite3
